// {{ ansible_managed }}
// Generado automáticamente por Ansible. No editar manualmente.

authoritative;

default-lease-time {{ dhcp_default_lease_time }};
max-lease-time {{ dhcp_max_lease_time }};

option domain-name "{{ dhcp_domain_name }}";
option domain-name-servers {{ dhcp_dns_servers | join(', ') }};

subnet {{ lab_network }} netmask {{ lab_netmask }} {
    range {{ dhcp_range_start }} {{ dhcp_range_end }};
    option routers {{ dhcp_router }};
    option subnet-mask {{ lab_netmask }};
    option broadcast-address {{ lab_network.split('.')[0:3] | join('.') }}.255;
}

{% for host in dhcp_static_hosts %}
host {{ host.name }} {
    hardware ethernet {{ host.mac }};
    fixed-address {{ host.ip }};
}
{% endfor %}
